FROM python:3.12-slim-bookworm@sha256:9c47360a2a0355e2da18516d0b1c2126ec22c195d2185e97347c9d98398c5bef
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    HF_HOME=/cache/hf HF_HUB_DISABLE_TELEMETRY=1 \
    HF_HUB_DISABLE_IMPLICIT_TOKEN=1 TRANSFORMERS_OFFLINE=1 HF_HUB_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false
WORKDIR /app
RUN groupadd --gid 10001 museforge && useradd --uid 10001 --gid 10001 --no-create-home museforge \
    && mkdir -p /var/lib/museforge/artifacts /cache/hf /weights \
    && chown -R 10001:10001 /var/lib/museforge /cache /weights
COPY packaging/yue2/requirements.lock /opt/yue2-test/requirements.lock
RUN python -m pip install --no-cache-dir --require-hashes \
    --extra-index-url https://download.pytorch.org/whl/cu128 -r /opt/yue2-test/requirements.lock \
    && python -m pip check
COPY packaging/yue2/requirements.museforge.lock /opt/museforge/requirements.lock
RUN python -m pip install --no-cache-dir --require-hashes -r /opt/museforge/requirements.lock \
    && python -m pip check
COPY src/ /app/src/
COPY packaging/yue2/acquire.py packaging/yue2/generate.py packaging/yue2/preflight.py \
     packaging/yue2/validate.py packaging/yue2/model-lock.json /opt/yue2-test/
USER 10001:10001
CMD ["python", "-m", "museforge.worker"]
