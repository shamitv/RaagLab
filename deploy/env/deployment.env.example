# Copy this file to the deployment root as .env. deploy/setup.sh generates it.
APP_PORT=8000
APP_BIND=127.0.0.1
POSTGRES_USER=museforge
POSTGRES_PASSWORD=replace-with-a-private-value
POSTGRES_DB=museforge
RABBITMQ_DEFAULT_USER=museforge
RABBITMQ_DEFAULT_PASS=replace-with-a-private-value
DATABASE_URL=postgresql+psycopg://museforge:replace-with-a-private-value@db:5432/museforge
BROKER_URL=amqp://museforge:replace-with-a-private-value@broker:5672//
WORKSPACE_ID=00000000-0000-4000-8000-000000000002
ARTIFACT_ROOT=/var/lib/museforge/artifacts
WEB_DIST=/app/web
LYRICS_PROVIDER=mock
MUSIC_PROVIDER=mock
MOCK_QUEUE=museforge.mock.v1
YUE2_QUEUE=museforge.yue2.v1
QUARANTINE_QUEUE=museforge.quarantine.v1
LOG_LEVEL=INFO
WEIGHTS_DIR=/var/lib/museforge/weights
CACHE_DIR=/var/cache/museforge
DEVICE=cpu
PRECISION=float32
WORKER_CONCURRENCY=1
DURATION_SECONDS=8
DISPATCHER_POLL_SECONDS=1
RECONCILIATION_SECONDS=5
OUTBOX_CLAIM_SECONDS=15
BROKER_TIMEOUT_SECONDS=5
UNCLAIMED_SECONDS=60
QUEUE_DEADLINE_SECONDS=1800
HEARTBEAT_SECONDS=5
LEASE_SECONDS=90
ATTEMPT_DEADLINE_SECONDS=3600
HARD_WATCHDOG_SECONDS=3660
CANCELLATION_GRACE_SECONDS=20
MAX_ATTEMPTS=3
ORPHAN_GRACE_SECONDS=86400
# YuE2 values are applied by deploy/start.sh in real mode.
# MODEL_ID=m-a-p/YuE2-3B
# MODEL_REVISION=29b3558dd46954a0cd9021dc76d5c91864a0f1c7
# DECODER_REVISION=9a94e1d0ea9f8087e98f77fa88df4a4068104d2a
# YUE2_DEVICE=auto
# YUE2_TEST_SMOKE=false
# YUE2_CPU_THREADS=4
# YUE2_MODEL_DIR=/weights/model
# YUE2_VAE_DIR=/weights/vae
# YUE2_MEMORY_BUDGET_GIB=16
# YUE2_PROCESS_TIMEOUT_SECONDS=3600
# YUE2_WARMUP_TIMEOUT_SECONDS=900
# YUE2_OFFLOAD_AR=false
