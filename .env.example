# Trusted local development only. setup.sh preserves an existing .env.
APP_PORT=8000
APP_BIND=127.0.0.1
# Reachable origin used in song QR codes, for example https://music.example.test
# SONG_LINK_BASE_URL=
CONTAINER_RESTART_POLICY=unless-stopped
POSTGRES_USER=museforge
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=museforge
RABBITMQ_DEFAULT_USER=museforge
RABBITMQ_DEFAULT_PASS=local-development-only
# Keep these credentials consistent with the database/broker variables above.
DATABASE_URL=postgresql+psycopg://museforge:local-development-only@db:5432/museforge
BROKER_URL=amqp://museforge:local-development-only@broker:5672//
WORKSPACE_ID=00000000-0000-4000-8000-000000000001
ARTIFACT_ROOT=/var/lib/museforge/artifacts
WEB_DIST=/app/web
LYRICS_PROVIDER=mock
MUSIC_PROVIDER=mock
MOCK_QUEUE=museforge.mock.v1
YUE2_QUEUE=museforge.yue2.v1
QUARANTINE_QUEUE=museforge.quarantine.v1
LOG_LEVEL=INFO
# setup.sh uses this safe baseline for explicit mock mode and converts a new
# environment to the pinned YuE2 settings when called without a mode.
# MODEL_ID=
# MODEL_REVISION=
# DECODER_REVISION=
WEIGHTS_DIR=/var/lib/museforge/weights
CACHE_DIR=/var/cache/museforge
DEVICE=cpu
PRECISION=float32
# YuE2 override (compose.yue2.yaml; add compose.yue2.gpu.yaml for GPU exposure):
# MUSIC_PROVIDER=yue2
# LYRICS_PROVIDER=user
# MODEL_ID=m-a-p/YuE2-3B
# MODEL_REVISION=29b3558dd46954a0cd9021dc76d5c91864a0f1c7
# DECODER_REVISION=9a94e1d0ea9f8087e98f77fa88df4a4068104d2a
# DEVICE=auto
# YUE2_DEVICE=auto
# YUE2_TEST_SMOKE=false
# YUE2_CPU_THREADS=4
# PRECISION=bfloat16
# YUE2_MODEL_DIR=/weights/model
# YUE2_VAE_DIR=/weights/vae
# YUE2_RUNNER=/opt/yue2-test/generate.py
# YUE2_PREFLIGHT=/opt/yue2-test/preflight.py
# YUE2_MEMORY_BUDGET_GIB=16
# YUE2_OFFLOAD_AR=false
# ATTEMPT_DEADLINE_SECONDS=900
# HARD_WATCHDOG_SECONDS=930
WORKER_CONCURRENCY=1
DURATION_SECONDS=8
DISPATCHER_POLL_SECONDS=1
RECONCILIATION_SECONDS=5
OUTBOX_CLAIM_SECONDS=15
BROKER_TIMEOUT_SECONDS=5
UNCLAIMED_SECONDS=60
QUEUE_DEADLINE_SECONDS=900
HEARTBEAT_SECONDS=5
LEASE_SECONDS=30
ATTEMPT_DEADLINE_SECONDS=60
HARD_WATCHDOG_SECONDS=75
CANCELLATION_GRACE_SECONDS=10
MAX_ATTEMPTS=3
ORPHAN_GRACE_SECONDS=86400
